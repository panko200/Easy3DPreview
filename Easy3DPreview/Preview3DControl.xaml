<UserControl x:Class="Easy3DPreview.Preview3DControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320" MinHeight="240">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ツールバー -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="⟲ リセット"
                        Command="{Binding ResetCommand}"
                        Padding="8,4" Margin="0,0,4,0"
                        FontSize="12"
                        Background="#3E3E42" Foreground="White"
                        BorderBrush="#555" BorderThickness="1"
                        Cursor="Hand"/>
                <Button Content="{Binding ProjectionLabel}"
                        Command="{Binding ToggleProjectionCommand}"
                        Padding="8,4" Margin="0,0,4,0"
                        FontSize="12"
                        Background="#3E3E42" Foreground="White"
                        BorderBrush="#555" BorderThickness="1"
                        Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- 3Dプレビュー領域 -->
        <Border Grid.Row="1" Background="#252526" ClipToBounds="True">
            <Image x:Name="PreviewImage"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   MouseWheel="OnMouseWheel"
                   MouseDown="OnMouseDown"
                   MouseMove="OnMouseMove"
                   MouseUp="OnMouseUp"/>
        </Border>

        <!-- ステータスバー -->
        <Border Grid.Row="2" Background="#007ACC" Padding="6,2">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="White"
                       FontSize="11"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
